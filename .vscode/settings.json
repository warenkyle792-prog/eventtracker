{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/client/dist": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/client/dist": true
  },
  "javascript.preferences.importModuleSpecifier": "relative"
}
