# ── EventTracker environment ──────────────────────────────
# Copy this file to `.env` and adjust values as needed.
# The defaults work fine for local development.

# Port for the Express API (and the app in production)
PORT=5000

# Vite dev-server URL (used for CORS hints / logs)
CLIENT_URL=http://localhost:5173

# Secret used to sign JWT auth tokens — change this in production!
JWT_SECRET=change-me-to-a-long-random-string
