# ─────────────────────────────────────────────────────────────────────────────
# EventTracker configuration
#
# Copy to `.env` and edit. Every value below has a working default, so the app
# runs without a .env file — payments simply stay in sandbox mode until real
# provider credentials are supplied.
#
# In production the two secrets are mandatory: the server refuses to start with
# the development signing key. Generate them with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development              # production enables HSTS, Secure cookies and strict secrets
CLIENT_URL=http://localhost:5173  # Vite dev server (development only)
PUBLIC_APP_URL=http://localhost:5000
# Extra browser origins allowed to call the API, comma separated. Same-origin
# requests and localhost are always allowed.
CORS_ORIGINS=
# Proxy hops in front of the app (Render/Fly/nginx = 1). Set to `false` when the
# app is exposed directly, otherwise client IPs will be wrong for rate limiting.
TRUST_PROXY=1
# CSP frame-ancestors. Widen only if you embed the app in another site.
FRAME_ANCESTORS='self'

# ── Security ────────────────────────────────────────────────────────────────
# Signing key for auth tokens — replace with a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# HMAC key used to sign ticket QR payloads (check-in rejects unsigned codes)
TICKET_SECRET=change-me-ticket-signing-secret
# How long a session survives without use, and how long each token lasts.
SESSION_DAYS=30
TOKEN_DAYS=30
# Force the session cookie's Secure flag. Defaults to on when NODE_ENV=production.
COOKIE_SECURE=
# Rate limits (requests per window, per IP).
RATE_LIMIT_PER_MINUTE=600         # all API traffic, per minute
RATE_LIMIT_AUTH=120               # sign-in / register / refresh, per 15 minutes
RATE_LIMIT_UPLOADS=60             # uploads, per 10 minutes
RATE_LIMIT_VERIFY=30              # ticket verification, per minute
RATE_LIMIT_SENSITIVE=20           # password + account changes, per 15 minutes
UPLOAD_JSON_LIMIT=12mb            # covers sent as base64 camera captures

# ── Storage ─────────────────────────────────────────────────────────────────
# Point these at a mounted volume in production — they hold everything the app
# owns: the SQLite database and all uploaded media.
DATA_DIR=                         # default: server/data
UPLOADS_DIR=                      # default: server/uploads
DB_FILE=                          # default: <DATA_DIR>/eventtracker.db

# ── M-Pesa (Safaricom Daraja) ────────────────────────────────────────────────
# Leave blank to keep M-Pesa in sandbox mode: intents stay `pending` until they
# are approved from the payment screen and nothing is charged.
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379            # Paybill / till number
MPESA_PASSKEY=
MPESA_CALLBACK_URL=               # https://your-domain/api/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=             # optional shared secret echoed in the callback URL

# ── Cards (Stripe) ──────────────────────────────────────────────────────────
# The publishable key is the only key the browser ever sees; the secret key and
# webhook secret stay on the server.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notes ───────────────────────────────────────────────────────────────────
# · The platform currency, service fee and support address live in the database
#   and are edited from Admin → Settings.
# · Anything left blank keeps that provider in sandbox mode; the app never
#   marks a payment successful without server-side confirmation.
